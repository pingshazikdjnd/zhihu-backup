# ── 本地日常同步（建议复制到根目录 .env.local 使用，已被 .gitignore 忽略）────────
# 后端入口地址：推荐填 Cloudflare Pages 域名（通过 _worker.js 同源反代至 Worker，免代理直连）；
# 本地全量调试时可临时覆盖为 http://127.0.0.1:18787，但不要把本地地址长期写入 .env.local
WORKER_URL=https://<项目名>.pages.dev
# 与 Worker 侧 `wrangler secret put API_SECRET` 一致的随机长密钥
API_SECRET=<与 Worker 侧 API_SECRET 一致的随机长密钥>
# 你的知乎 url_token（个人主页 /people/<url_token> 中的标识）
ZHIHU_USERNAME=<你的知乎 url_token>

# 可选：访问 *.workers.dev 需要代理时启用（需 Node >= 22.21 或 >= 24.0 才支持原生 fetch 代理）
# HTTPS_PROXY=http://127.0.0.1:7890
# 可选：本地兜底知乎 Cookie（优先从 Worker /ingest/sync-state 读取线上 D1 保存的 Cookie）
# ZHIHU_COOKIE=<浏览器复制的完整知乎 cookie 字符串>

# ── 前端开发与构建（Vite 根目录环境变量）────────────────────────────────────────
# 留空即可：开发时走 apps/web/vite.config.ts 的 /api 代理（-> http://127.0.0.1:18787）；
# 生产构建走 Pages public/_worker.js 同源 Service Binding（env.API）
VITE_API_BASE=
# 可选：前端「我的回答」作者 token（未配置时通过 &mine=1 由 Worker 侧 ZHIHU_USERNAME 过滤）
VITE_ZHIHU_USERNAME=<你的知乎 url_token>

# ── 打包上云工具（scripts/upload-to-cloudflare.mjs --execute-remote 可选）─────────
# 配置后启用 Cloudflare REST API 高并发上传与线上 R2 清空；未配置时自动回退 wrangler CLI
# CF_ACCOUNT_ID=<你的 Cloudflare Account ID>
# CF_API_TOKEN=<具有 D1 Edit 与 R2 Edit 权限的 Cloudflare API Token>
