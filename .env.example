API_PORT=3001
DB_PATH=./data/app.db
VITE_API_BASE=http://localhost:3001

BROWSER_USER_DATA_DIR=./data/browser
ZHIHU_USERNAME=your_username_here
# 前端「我的回答」用的作者 token（VITE_ 前缀才会打进 bundle）
VITE_ZHIHU_USERNAME=your_username_here

# ── 扫码登录（pnpm zhihu:login）────────────────────────────
# Worker 的公网地址，Apify 回传数据也用它
WORKER_URL=https://gemini-zhihu-api.<你的子域>.workers.dev
# 与 worker 上 `wrangler secret put API_SECRET` 的值保持一致
API_SECRET=replace_with_a_long_random_string
# 扫码用的独立浏览器 profile（不影响你日常浏览器）
ZHIHU_LOGIN_PROFILE=./data/zhihu-login-profile
# 网页展示二维码的本地转发端口
ZHIHU_QR_PORT=3030
